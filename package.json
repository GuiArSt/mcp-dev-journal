{
  "name": "tartarus-workspace",
  "version": "1.0.0",
  "description": "Tartarus MCP server with Kronus AI agent",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:better-sqlite3 --external:@ai-sdk/anthropic --external:@ai-sdk/openai --external:@ai-sdk/google --external:ai --external:@modelcontextprotocol/sdk --external:@modelcontextprotocol/ext-apps --external:chalk --external:zod && chmod +x dist/index.js",
    "build:tsc": "tsc && chmod +x dist/index.js",
    "build:apps": "vite build --config vite.config.apps.ts",
    "dev": "tsc --watch",
    "dev:apps": "vite build --config vite.config.apps.ts --watch",
    "start": "node dist/index.js",
    "rebuild:native": "bash scripts/rebuild-native.sh",
    "test": "npx tsx tests/object-registry.test.ts && npx tsx tests/mcp-integration.test.ts",
    "test:registry": "npx tsx tests/object-registry.test.ts",
    "test:mcp": "npx tsx tests/mcp-integration.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tartarus",
    "kronus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.12",
    "@ai-sdk/google": "^3.0.7",
    "@ai-sdk/openai": "^3.0.9",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "ai": "^6.0.33",
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
