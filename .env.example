# Tartarus MCP Server (monorepo root)
# Copy this file to .env and configure your credentials

# ============================================
# AI Provider (Required)
# ============================================
# You need at least ONE of these for the Journal module to work
# Priority: Anthropic (preferred) → OpenAI → Google (first one found)
# Models are hardcoded: claude-4.5-sonnet, gpt-5.1, gemini-3

# Anthropic (Claude 4.5 Sonnet) - Recommended
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OR OpenAI (GPT 5.1)
# OPENAI_API_KEY=sk-your-key-here

# OR Google (Gemini 3)
# Also required for: journal_scan_repository (Gemini 3 Pro analysis),
# kronus_ask quick/deep modes (Gemini 3 Flash/Pro)
# GOOGLE_API_KEY=your-key-here

# ============================================
# Optional Configuration
# ============================================
# Journal database path (default: journal.db in project root)
# Set to custom path if you want database elsewhere
# JOURNAL_DB_PATH=./journal.db

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Soul.xml path (Optional)
# Path to Soul.xml file (default: Soul.xml in project root)
# Use this to point to a local full version (e.g., Soul.xml.local) without committing it
# SOUL_XML_PATH=./Soul.xml.local

# Tartarus Web App URL (Optional)
# Base URL for the Tartarus web app (enables download URLs for attachments in MCP responses)
# This allows MCP clients to download full attachment files via HTTP, bypassing MCP truncation limits
# TARTARUS_URL=http://localhost:3777

# Perplexity API Key (Optional - for web search tools in Kronus)
# Get from: https://perplexity.ai → Settings → API
# Enables: perplexity_search (Search API), perplexity_ask/research/reason (Sonar)
# When set, web_search defaults to Perplexity Search API (falls back to Gemini on error)
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx
# SEARCH_PROVIDER=perplexity   # or gemini — force a provider for web_search

# Nebius Token Factory (Optional - OpenAI-compatible inference, not wired in chat yet)
# Get from: https://tokenfactory.nebius.com/
# NEBIUS_API_KEY=your-nebius-api-key
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_CHAT_MODEL=moonshotai/Kimi-K2.5

# ============================================
# Linear Integration (Optional - for project management)
# ============================================
# LINEAR_API_KEY=lin_api_your-key-here
# LINEAR_USER_ID=your-user-id
# LINEAR_TEAM_ID=your-team-id

# ============================================
# Slite Integration (Optional - for knowledge base)
# ============================================
# Get from: Slite → Settings → Developers → API key
# SLITE_API_KEY=your-slite-api-key-here

# ============================================
# Notion Integration (Optional - for workspace pages)
# ============================================
# Get from: https://www.notion.so/my-integrations → Create integration → Copy secret
# NOTION_API_KEY=your-notion-integration-secret-here

# ============================================
# Supabase Storage (Optional - for cloud image storage)
# ============================================
# Get these from: Supabase Dashboard → Settings → API
# New key format (2025+): sb_publishable_... and sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Legacy key format (still supported for backwards compatibility):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================
# Backblaze B2 (Optional - fortress media + backups)
# ============================================
# S3-compatible object storage for media bytes and encrypted DB snapshots.
# B2_APPLICATION_KEY_ID=your-key-id
# B2_APPLICATION_KEY=your-application-key
# B2_BUCKET_MEDIA=tartarus-media
# B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2_REGION=eu-central-003

# ============================================
# Agent Configuration (Optional)
# ============================================
# Name of your AI agent (default: "Kronus")
# AGENT_NAME=Kronus

# Path to agent prompt file (default: "Soul.xml")
# Relative to project root or absolute path
# AGENT_SOUL_PATH=Soul.xml
